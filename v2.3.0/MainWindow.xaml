<Window x:Class="BorderControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Border Control"
        Width="400" Height="808"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource Text}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Shared shield outline (0..100 box) – same geometry as the app/tray icons. -->
        <PathGeometry x:Key="ShieldGeo"
                      Figures="M50,5 C62,13 75,17 89,18 L89,47 C89,72 72,87 50,95 C28,87 11,72 11,47 L11,18 C25,17 38,13 50,5 Z"/>
    </Window.Resources>

    <Grid x:Name="Root" Background="#D90B0D12">

        <!-- ───────── ambient light, tinted by status ───────── -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="Blob1" Width="380" Height="300" Canvas.Left="-60" Canvas.Top="-40">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#447C8396"/>
                        <GradientStop Offset="1" Color="#007C8396"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform x:Name="Blob1T"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="Blob2" Width="320" Height="260" Canvas.Left="140" Canvas.Top="40">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#2E7C8396"/>
                        <GradientStop Offset="1" Color="#007C8396"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform x:Name="Blob2T"/></Ellipse.RenderTransform>
            </Ellipse>
            <!-- fades the light out before the content area -->
            <Rectangle Width="400" Height="420">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.35" Color="#000B0D12"/>
                        <GradientStop Offset="1" Color="#FF0B0D12"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ───────── title bar ───────── -->
            <Grid Grid.Row="0" Margin="16,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="16" Height="16" Margin="0,0,9,0">
                        <Path Data="{StaticResource ShieldGeo}" Stretch="Uniform" Fill="{DynamicResource Status}"/>
                        <Path Data="{StaticResource ShieldGeo}" Stretch="Uniform" Margin="-2.5"
                              Stroke="{DynamicResource Status}" StrokeThickness="1" StrokeDashArray="1.6 1.4" Opacity="0.55"/>
                    </Grid>
                    <TextBlock Text="Border Control" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimise"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click"/>
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" ToolTip="Hide to tray"
                            WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- ───────── hero: status ring ───────── -->
            <StackPanel x:Name="Hero" Grid.Row="1" Margin="0,0,0,12">
                <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>

                <Grid Width="140" Height="140" HorizontalAlignment="Center">
                    <!-- inner glow disc -->
                    <Ellipse Width="104" Height="104">
                        <Ellipse.Fill>
                            <RadialGradientBrush x:Name="CoreBrush">
                                <GradientStop Offset="0" Color="#267C8396"/>
                                <GradientStop Offset="1" Color="#007C8396"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- track -->
                    <Ellipse Width="120" Height="120" Stroke="#14FFFFFF" StrokeThickness="2"/>

                    <!-- status ring: one segment per check, coloured by its result, with a soft glow -->
                    <Canvas x:Name="Ring" Width="140" Height="140" Opacity="0.95">
                        <Canvas.Effect>
                            <DropShadowEffect x:Name="RingGlow" ShadowDepth="0" BlurRadius="22" Opacity="0.55"
                                              Color="#7C8396"/>
                        </Canvas.Effect>
                    </Canvas>

                    <!-- spinning arc while checking -->
                    <Ellipse x:Name="Arc" Width="120" Height="120" StrokeThickness="2.5" Opacity="0"
                             StrokeDashArray="34 200" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Stroke>
                            <SolidColorBrush Color="#ECEEF3"/>
                        </Ellipse.Stroke>
                        <Ellipse.RenderTransform><RotateTransform x:Name="ArcSpin"/></Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- dashed "border" around the shield: the Border Control mark -->
                    <Path Data="{StaticResource ShieldGeo}" Stretch="Uniform" Width="66" Height="66"
                          Stroke="{DynamicResource Status}" StrokeThickness="1.4" StrokeDashArray="2.2 2"
                          StrokeDashCap="Round" Opacity="0.45"/>

                    <!-- shield -->
                    <Path Data="{StaticResource ShieldGeo}" Stretch="Uniform" Width="50" Height="50"
                          Stroke="{DynamicResource Status}" StrokeThickness="1.6">
                        <Path.Fill>
                            <SolidColorBrush x:Name="ShieldFill" Color="#267C8396"/>
                        </Path.Fill>
                    </Path>

                    <!-- status glyph (crossfades with a blur mask) -->
                    <Path x:Name="Glyph" Width="20" Height="20" Margin="0,0,0,3"
                          Stroke="{DynamicResource Status}" StrokeThickness="2.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M5.5,10 L14.5,10" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><ScaleTransform x:Name="GlyphScale"/></Path.RenderTransform>
                        <Path.Effect><BlurEffect x:Name="GlyphBlur" Radius="0"/></Path.Effect>
                    </Path>
                </Grid>

                <Grid x:Name="HeadlineHost" Margin="24,10,24,0" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><TranslateTransform x:Name="HeadlineShift"/></Grid.RenderTransform>
                    <Grid.Effect><BlurEffect x:Name="HeadlineBlur" Radius="0"/></Grid.Effect>
                    <StackPanel>
                        <TextBlock x:Name="HeadlineText" Text="Starting…" FontFamily="{StaticResource Display}" TextOptions.TextRenderingMode="Grayscale"
                                   FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Image x:Name="HeroFlag" Style="{StaticResource FlagImage}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="SubHeadline" Text=" " FontSize="12" Foreground="{StaticResource Muted}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ───────── clocks ───────── -->
            <Grid x:Name="Clocks" Grid.Row="2" Margin="16,0,16,8">
                <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}"
                        BorderThickness="1" CornerRadius="14" Padding="14,8,14,9">
                    <StackPanel>
                        <TextBlock Text="Your time" FontSize="11" Foreground="{StaticResource Muted}"/>
                        <TextBlock FontFamily="{StaticResource Display}" Typography.NumeralAlignment="Tabular" Margin="0,1,0,0" TextOptions.TextRenderingMode="Grayscale">
                            <Run x:Name="RealHm" Text="--:--" FontSize="24" FontWeight="Light"/><Run
                                 x:Name="RealSec" Text=":--" FontSize="14" Foreground="{StaticResource Faint}"/>
                        </TextBlock>
                        <TextBlock x:Name="RealZone" FontSize="11" Foreground="{StaticResource Faint}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <Border x:Name="SysTile" Grid.Column="2" Background="{StaticResource Surface}"
                        BorderThickness="1" CornerRadius="14" Padding="14,8,14,9">
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="SysTileStroke" Color="#12FFFFFF"/>
                    </Border.BorderBrush>
                    <StackPanel>
                        <TextBlock x:Name="SysLabel" Text="Apps see" FontSize="11" Foreground="{StaticResource Muted}"/>
                        <TextBlock FontFamily="{StaticResource Display}" Typography.NumeralAlignment="Tabular" Margin="0,1,0,0" TextOptions.TextRenderingMode="Grayscale">
                            <Run x:Name="SysHm" Text="--:--" FontSize="24" FontWeight="Light"/><Run
                                 x:Name="SysSec" Text=":--" FontSize="14" Foreground="{StaticResource Faint}"/>
                        </TextBlock>
                        <TextBlock x:Name="SysZone" FontSize="11" Foreground="{StaticResource Faint}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ───────── live speed (click for traffic stats) ───────── -->
            <Border x:Name="SpeedCard" Grid.Row="3" Margin="16,0,16,8" Height="74" Cursor="Hand"
                    Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                    CornerRadius="14" ClipToBounds="True" MouseLeftButtonUp="SpeedCard_Click"
                    ToolTip="Live speed – click for traffic stats">
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="158"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="14,8,0,0" VerticalAlignment="Top">
                        <TextBlock Text="Speed" FontSize="11" Foreground="{StaticResource Muted}"/>
                        <TextBlock FontFamily="{StaticResource Display}" Typography.NumeralAlignment="Tabular"
                                   TextOptions.TextRenderingMode="Grayscale" Margin="0,0,0,0">
                            <Run Text="↓ " FontSize="15" Foreground="#8EE6B8"/><Run x:Name="DownValue" Text="0" FontSize="22"
                                 FontWeight="Light"/><Run x:Name="DownUnit" Text=" KB/s" FontSize="12" Foreground="{StaticResource Faint}"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{StaticResource Faint}" Typography.NumeralAlignment="Tabular">
                            <Run Text="↑" Foreground="#8EC5FF"/><Run x:Name="UpText" Text=" 0 KB/s"/><Run Text="  ·  today "/><Run
                                 x:Name="TodayText" Text="0 KB"/>
                        </TextBlock>
                    </StackPanel>
                    <!-- last 60 s: download area + upload line, scrolling left -->
                    <Canvas x:Name="Spark" Grid.Column="1" ClipToBounds="True" Margin="0,10,0,0">
                        <Canvas.RenderTransform><TranslateTransform x:Name="SparkShift"/></Canvas.RenderTransform>
                        <Path x:Name="SparkDownFill">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#4D8EE6B8"/>
                                    <GradientStop Offset="1" Color="#008EE6B8"/>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <Path x:Name="SparkDown" Stroke="#8EE6B8" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                        <Path x:Name="SparkUp" Stroke="#8EC5FF" StrokeThickness="1.1" StrokeLineJoin="Round" Opacity="0.85"/>
                    </Canvas>
                    <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="10"
                               Foreground="{StaticResource Faint}" HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,9,11,0"/>
                </Grid>
            </Border>

            <!-- ───────── checks ───────── -->
            <Border x:Name="Checks" Grid.Row="4" Margin="16,0,16,0" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,2">
                    <ItemsControl x:Name="StatusList" Margin="0,0,0,-1">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1"
                                        Padding="12,9,14,9" Cursor="Hand" MouseLeftButtonUp="Row_Click"
                                        ToolTip="Click to see the full message">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#08FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- pastel status badge: tinted disc + glyph -->
                                        <Grid x:Name="badge" Width="22" Height="22" VerticalAlignment="Top" HorizontalAlignment="Left"
                                              Margin="0,1,0,0" RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform><ScaleTransform x:Name="badgeScale"/></Grid.RenderTransform>
                                            <Grid.Effect><BlurEffect x:Name="badgeBlur" Radius="0"/></Grid.Effect>

                                            <Ellipse x:Name="halo" Opacity="0" Fill="#FF9C9C" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform><ScaleTransform x:Name="haloScale"/></Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse x:Name="disc" Fill="#1FA9B0C2" Stroke="#40A9B0C2" StrokeThickness="1"/>
                                            <Path x:Name="mark" Width="12" Height="12" Stretch="None"
                                                  Stroke="#A9B0C2" StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Data="M3,6 L9,6"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{StaticResource Muted}"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="31"
                                                       Margin="0,2,0,0" LineHeight="15.5" LineStackingStrategy="BlockLineHeight"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Colours are plain setters (always applied, even on first render);
                                     a change of state gets a quick blur-pop so the eye catches it. -->
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="Ok">
                                        <Setter TargetName="disc" Property="Fill" Value="#268EE6B8"/>
                                        <Setter TargetName="disc" Property="Stroke" Value="#4D8EE6B8"/>
                                        <Setter TargetName="mark" Property="Stroke" Value="#8EE6B8"/>
                                        <Setter TargetName="mark" Property="Data" Value="M2.6,6.3 L5,8.7 L9.6,3.6"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="badgeScale" Storyboard.TargetProperty="ScaleX" From="0.82" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}"/>
                                                    <DoubleAnimation Storyboard.TargetName="badgeScale" Storyboard.TargetProperty="ScaleY" From="0.82" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}"/>
                                                    <DoubleAnimation Storyboard.TargetName="badgeBlur" Storyboard.TargetProperty="Radius" From="4" To="0" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOut}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Warn">
                                        <Setter TargetName="disc" Property="Fill" Value="#26FFD58A"/>
                                        <Setter TargetName="disc" Property="Stroke" Value="#4DFFD58A"/>
                                        <Setter TargetName="mark" Property="Stroke" Value="#FFD58A"/>
                                        <Setter TargetName="mark" Property="Data" Value="M6,2.6 L6,6.6 M6,9.2 L6,9.3"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="badgeScale" Storyboard.TargetProperty="ScaleX" From="0.82" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}"/>
                                                    <DoubleAnimation Storyboard.TargetName="badgeScale" Storyboard.TargetProperty="ScaleY" From="0.82" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}"/>
                                                    <DoubleAnimation Storyboard.TargetName="badgeBlur" Storyboard.TargetProperty="Radius" From="4" To="0" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOut}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <!-- a leak also sends two soft ripples: rare, worth noticing -->
                                    <DataTrigger Binding="{Binding Level}" Value="Bad">
                                        <Setter TargetName="disc" Property="Fill" Value="#2BFF9C9C"/>
                                        <Setter TargetName="disc" Property="Stroke" Value="#59FF9C9C"/>
                                        <Setter TargetName="mark" Property="Stroke" Value="#FF9C9C"/>
                                        <Setter TargetName="mark" Property="Data" Value="M3.4,3.4 L8.6,8.6 M8.6,3.4 L3.4,8.6"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="badgeScale" Storyboard.TargetProperty="ScaleX" From="0.82" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}"/>
                                                    <DoubleAnimation Storyboard.TargetName="badgeScale" Storyboard.TargetProperty="ScaleY" From="0.82" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}"/>
                                                    <DoubleAnimation Storyboard.TargetName="badgeBlur" Storyboard.TargetProperty="Radius" From="4" To="0" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOut}"/>
                                                    <DoubleAnimation Storyboard.TargetName="haloScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.9" Duration="0:0:0.9" RepeatBehavior="2x" EasingFunction="{StaticResource EaseOut}"/>
                                                    <DoubleAnimation Storyboard.TargetName="haloScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.9" Duration="0:0:0.9" RepeatBehavior="2x" EasingFunction="{StaticResource EaseOut}"/>
                                                    <DoubleAnimation Storyboard.TargetName="halo" Storyboard.TargetProperty="Opacity" From="0.45" To="0" Duration="0:0:0.9" RepeatBehavior="2x" EasingFunction="{StaticResource EaseOut}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ───────── controls ───────── -->
            <StackPanel x:Name="Footer" Grid.Row="5" Margin="16,10,16,16">
                <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>

                <!-- all options live in Settings now -->
                <UniformGrid Columns="4">
                    <Button x:Name="RecheckButton" Style="{StaticResource IconButton}" Width="NaN" Height="36"
                            Margin="0,0,3,0" Click="Recheck_Click" ToolTip="Run every check again">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="RecheckIcon" Text="&#xE72C;" FontSize="12" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform><RotateTransform x:Name="RecheckSpin"/></TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="Check" FontFamily="{StaticResource Text}" FontSize="12" Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="NaN" Height="36" Margin="3,0"
                            Click="Restore_Click" ToolTip="Undo every change Border Control made, now">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Restore" FontFamily="{StaticResource Text}" FontSize="12" Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="NaN" Height="36" Margin="3,0"
                            Click="Activity_Click" ToolTip="Show the event log">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Activity" FontFamily="{StaticResource Text}" FontSize="12" Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="NaN" Height="36" Margin="3,0,0,0"
                            Click="Settings_Click" ToolTip="Options, kill switch and updates">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" FontFamily="{StaticResource Text}" FontSize="12" Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Grid>

        <!-- ───────── new-version popup ───────── -->
        <Border x:Name="UpdateBanner" VerticalAlignment="Top" Margin="12,46,12,0" Padding="14,12"
                CornerRadius="14" Background="#F51A2029" BorderBrush="#408EE6B8" BorderThickness="1"
                Visibility="Collapsed" Opacity="0">
            <Border.RenderTransform><TranslateTransform x:Name="BannerShift" Y="-14"/></Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect ShadowDepth="6" BlurRadius="24" Opacity="0.45" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Width="22" Height="22" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Ellipse Fill="#268EE6B8" Stroke="#4D8EE6B8" StrokeThickness="1"/>
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="#8EE6B8"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="UpdateTitle" Text="Version ready" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="Downloaded and verified. Restarting keeps your current settings."
                               FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="9"
                        Width="24" Height="24" VerticalAlignment="Top" Click="UpdateLater_Click" ToolTip="Later"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Click="UpdateRestart_Click">
                        <TextBlock Text="Restart now" FontFamily="{StaticResource Text}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#0E1016" Margin="14,0"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="NaN" Height="30" Margin="8,0,0,0"
                            Click="UpdateNotes_Click">
                        <TextBlock Text="What's new" FontFamily="{StaticResource Text}" FontSize="12" Margin="14,0"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ───────── bottom sheet: activity log or one check's full message ───────── -->
        <Border x:Name="Scrim" Background="#000000" Opacity="0" IsHitTestVisible="False"
                MouseLeftButtonDown="Scrim_MouseDown"/>

        <Border x:Name="Sheet" VerticalAlignment="Bottom" Height="500" CornerRadius="18,18,0,0"
                Background="#FA12151C" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0"
                Padding="16,10,16,16" Visibility="Collapsed">
            <Border.RenderTransform><TranslateTransform x:Name="SheetShift" Y="520"/></Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Width="36" Height="4" CornerRadius="2" Background="#26FFFFFF"
                        HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Grid Margin="0,12,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SheetTitle" Text="Activity" FontFamily="{StaticResource Display}" FontSize="15"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SheetStatus" FontSize="11.5" Margin="0,1,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <Button x:Name="CopyButton" Grid.Column="1" Style="{StaticResource IconButton}" Width="NaN" Height="28"
                            Margin="0,0,6,0" Click="Copy_Click" ToolTip="Copy to clipboard">
                        <StackPanel Orientation="Horizontal" Margin="10,0">
                            <TextBlock x:Name="CopyIcon" Text="&#xE8C8;" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CopyLabel" Text="Copy" FontFamily="{StaticResource Text}" FontSize="11.5"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8BB;" FontSize="10"
                            Width="28" Height="28" Click="SheetClose_Click" ToolTip="Close"/>
                </Grid>

                <!-- traffic stats -->
                <ScrollViewer x:Name="StatsPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="0,0,6,8">
                        <Grid Margin="2,4,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#8EE6B8" Margin="0,0,6,0"/>
                                <TextBlock Text="Download" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,14,0"/>
                                <Ellipse Width="7" Height="7" Fill="#8EC5FF" Margin="0,0,6,0"/>
                                <TextBlock Text="Upload" FontSize="11" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </Grid>

                        <!-- live -->
                        <Border Style="{StaticResource Card}" Padding="14,12">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Right now" FontSize="11" Foreground="{StaticResource Muted}"/>
                                        <TextBlock FontFamily="{StaticResource Display}" Typography.NumeralAlignment="Tabular"
                                                   TextOptions.TextRenderingMode="Grayscale">
                                            <Run Text="↓ " FontSize="17" Foreground="#8EE6B8"/><Run x:Name="BigDown" Text="0 KB/s"
                                                 FontSize="26" FontWeight="Light"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <TextBlock FontFamily="{StaticResource Display}" Typography.NumeralAlignment="Tabular"
                                                   HorizontalAlignment="Right" TextOptions.TextRenderingMode="Grayscale">
                                            <Run Text="↑ " FontSize="13" Foreground="#8EC5FF"/><Run x:Name="BigUp" Text="0 KB/s" FontSize="17"
                                                 FontWeight="Light"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                <Grid Height="110" Margin="0,10,0,0">
                                    <Border BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,0,1"/>
                                    <Border BorderBrush="#0CFFFFFF" BorderThickness="0,1,0,0" VerticalAlignment="Top"/>
                                    <Border BorderBrush="#0CFFFFFF" BorderThickness="0,1,0,0" VerticalAlignment="Center"/>
                                    <Canvas x:Name="BigChart" ClipToBounds="True">
                                        <Canvas.RenderTransform><TranslateTransform x:Name="BigShift"/></Canvas.RenderTransform>
                                        <Path x:Name="BigDownFill">
                                            <Path.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#558EE6B8"/>
                                                    <GradientStop Offset="1" Color="#008EE6B8"/>
                                                </LinearGradientBrush>
                                            </Path.Fill>
                                        </Path>
                                        <Path x:Name="BigDownLine" Stroke="#8EE6B8" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                                        <Path x:Name="BigUpLine" Stroke="#8EC5FF" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                                    </Canvas>
                                    <TextBlock x:Name="BigScale" FontSize="10" Foreground="{StaticResource Faint}"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0"/>
                                </Grid>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock Text="last 2 minutes" FontSize="10.5" Foreground="{StaticResource Faint}"/>
                                    <TextBlock x:Name="PeakText" FontSize="10.5" Foreground="{StaticResource Faint}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- this session -->
                        <TextBlock Text="This VPN session" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="14,10">
                            <UniformGrid Columns="3">
                                <StackPanel>
                                    <TextBlock Text="Downloaded" FontSize="11" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="SessDown" Text="–" FontSize="15" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Uploaded" FontSize="11" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="SessUp" Text="–" FontSize="15" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Connected" FontSize="11" Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="SessTime" Text="–" FontSize="15" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>

                        <!-- totals -->
                        <TextBlock Text="Traffic through the VPN" Style="{StaticResource SectionTitle}"/>
                        <UniformGrid x:Name="TotalsGrid" Columns="2" Margin="-4,4,-4,0"/>

                        <!-- 14 days -->
                        <TextBlock Text="Last 14 days" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,12,12,8">
                            <StackPanel>
                                <Grid x:Name="Bars" Height="120"/>
                                <Grid x:Name="BarLabels" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="2,14,0,0">
                            <TextBlock x:Name="StatsSince" FontSize="11" Foreground="{StaticResource Faint}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,0,110,0"/>
                            <Button Style="{StaticResource IconButton}" Width="NaN" Height="28" HorizontalAlignment="Right"
                                    Click="StatsReset_Click" ToolTip="Clear all saved traffic totals">
                                <TextBlock Text="Reset stats" FontFamily="{StaticResource Text}" FontSize="11.5" Margin="12,0"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- settings -->
                <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="0,0,6,8">

                        <TextBlock Text="While the VPN is on" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Every change is undone when the VPN disconnects, when you exit, or after a crash."
                                   Style="{StaticResource SectionNote}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="AutoToggle" Style="{StaticResource Switch}" Click="AutoToggle_Click" Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Match time zone to VPN" Style="{StaticResource OptionTitle}"/>
                                        <TextBlock Text="Your clock follows the VPN location, so sites can't compare it with your IP."
                                                   Style="{StaticResource OptionNote}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Rule}"/>
                                <CheckBox x:Name="LocationToggle" Style="{StaticResource Switch}" Click="LocationToggle_Click" Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Turn off Windows location" Style="{StaticResource OptionTitle}"/>
                                        <TextBlock Text="Apps can't work out your position from nearby Wi-Fi networks."
                                                   Style="{StaticResource OptionNote}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Rule}"/>
                                <CheckBox x:Name="KeyboardToggle" Style="{StaticResource Switch}" Click="KeyboardToggle_Click" Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Add VPN country keyboard" Style="{StaticResource OptionTitle}"/>
                                        <TextBlock Text="Your keyboard list fits the VPN country. Keyboards you already have are never removed."
                                                   Style="{StaticResource OptionNote}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Rule}"/>
                                <CheckBox x:Name="RegionToggle" Style="{StaticResource Switch}" Click="RegionToggle_Click" Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Match Windows region" Style="{StaticResource OptionTitle}"/>
                                        <TextBlock Text="Apps and Microsoft services see the VPN country as your region. Date and number formats stay as they are."
                                                   Style="{StaticResource OptionNote}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Rule}"/>
                                <CheckBox x:Name="FlushToggle" Style="{StaticResource Switch}" Click="FlushToggle_Click" Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Clear DNS cache on connect and disconnect" Style="{StaticResource OptionTitle}"/>
                                        <TextBlock Text="Forgets lookups made outside the VPN, so sites don't get answers tied to your real location."
                                                   Style="{StaticResource OptionNote}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Rule}"/>
                                <CheckBox x:Name="Ipv6Toggle" Style="{StaticResource Switch}" Click="Ipv6Toggle_Click" Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Turn off IPv6 outside the VPN" Style="{StaticResource OptionTitle}"/>
                                        <TextBlock Text="Stops IPv6 traffic slipping past a VPN that only covers IPv4. Leave off if your VPN connects to its server over IPv6."
                                                   Style="{StaticResource OptionNote}"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="When the VPN drops" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="The kill switch closes these apps the moment the VPN connection is lost."
                                   Style="{StaticResource SectionNote}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="KillToggle" Style="{StaticResource Switch}" Click="KillToggle_Click" Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Close chosen apps" Style="{StaticResource OptionTitle}"/>
                                        <TextBlock Text="They're closed instantly so nothing leaks – unsaved work in them is lost."
                                                   Style="{StaticResource OptionNote}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Rule}"/>
                                <CheckBox x:Name="KeepClosedToggle" Style="{StaticResource Switch}" Click="KeepClosedToggle_Click" Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Keep them closed until the VPN is back" Style="{StaticResource OptionTitle}"/>
                                        <TextBlock Text="If one is reopened without the VPN, it's closed again."
                                                   Style="{StaticResource OptionNote}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Rule}"/>

                                <TextBlock x:Name="KillEmpty" Text="No apps chosen yet." FontSize="12"
                                           Foreground="{StaticResource Faint}" Margin="0,10,0,4"/>
                                <ItemsControl x:Name="KillList" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                       RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Icon}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Path}" FontSize="10.5" Foreground="{StaticResource Faint}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9"
                                                        Width="26" Height="26" Margin="8,0,0,0" Tag="{Binding Path}"
                                                        Click="KillRemove_Click" ToolTip="Remove"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,10">
                                    <Button Style="{StaticResource IconButton}" Width="NaN" Height="30" Click="KillPickRunning_Click">
                                        <StackPanel Orientation="Horizontal" Margin="12,0">
                                            <TextBlock Text="&#xE710;" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="Add running app" FontFamily="{StaticResource Text}" FontSize="12"
                                                       Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="NaN" Height="30" Margin="8,0,0,0"
                                            Click="KillBrowse_Click">
                                        <TextBlock Text="Browse…" FontFamily="{StaticResource Text}" FontSize="12" Margin="12,0"/>
                                    </Button>
                                </StackPanel>

                                <!-- running-app picker -->
                                <Border x:Name="RunningPicker" Visibility="Collapsed" Margin="0,0,0,10" CornerRadius="10"
                                        Background="#0AFFFFFF" BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                                    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="RunningList" Margin="4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding Path}" Click="KillAddRunning_Click" Cursor="Hand"
                                                            ToolTip="{Binding Path}" Focusable="False">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="8,6">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Width="16" Height="16" Source="{Binding Icon}" Margin="0,0,10,0"
                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{StaticResource Ink}"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Notifications" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Choose what Border Control tells you about." Style="{StaticResource SectionNote}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="NotifyConnToggle" Style="{StaticResource Switch}" Click="Notify_Click" Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="VPN connected or disconnected" Style="{StaticResource OptionTitle}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Rule}"/>
                                <CheckBox x:Name="NotifyLeakToggle" Style="{StaticResource Switch}" Click="Notify_Click" Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Leaks" Style="{StaticResource OptionTitle}"/>
                                        <TextBlock Text="When a check finds your real IP, DNS or location exposed." Style="{StaticResource OptionNote}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Rule}"/>
                                <CheckBox x:Name="NotifyChangeToggle" Style="{StaticResource Switch}" Click="Notify_Click" Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Changes to your PC" Style="{StaticResource OptionTitle}"/>
                                        <TextBlock Text="Time zone, location, keyboard, region and IPv6 changed or restored." Style="{StaticResource OptionNote}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Rule}"/>
                                <CheckBox x:Name="NotifyKillToggle" Style="{StaticResource Switch}" Click="Notify_Click" Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Kill switch" Style="{StaticResource OptionTitle}"/>
                                        <TextBlock Text="When apps are closed because the VPN dropped." Style="{StaticResource OptionNote}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Rule}"/>
                                <CheckBox x:Name="NotifyUpdateToggle" Style="{StaticResource Switch}" Click="Notify_Click" Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Updates" Style="{StaticResource OptionTitle}"/>
                                        <TextBlock Text="When a new version is downloaded and ready." Style="{StaticResource OptionNote}"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Tray" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <CheckBox x:Name="TraySpeedToggle" Style="{StaticResource Switch}" Click="TraySpeed_Click" Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Show download speed in the tray" Style="{StaticResource OptionTitle}"/>
                                        <TextBlock Text="A second icon next to the status shield, updated every second. If Windows hides it, drag it from the ^ overflow onto the taskbar."
                                                   Style="{StaticResource OptionNote}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Rule}"/>
                                <StackPanel Margin="0,10,0,10">
                                    <TextBlock Text="When hovering the tray icon, show" Style="{StaticResource OptionTitle}"/>
                                    <TextBlock Text="Your real time and the overall status are always shown, plus:" Style="{StaticResource OptionNote}"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <ToggleButton x:Name="HoverLeaks" Style="{StaticResource Chip}" Content="Leaks" Tag="Leaks" Click="Hover_Click"/>
                                        <ToggleButton x:Name="HoverSpeed" Style="{StaticResource Chip}" Content="Speed" Tag="Speed" Click="Hover_Click"/>
                                        <ToggleButton x:Name="HoverTraffic" Style="{StaticResource Chip}" Content="Today's traffic" Tag="Traffic" Click="Hover_Click"/>
                                        <ToggleButton x:Name="HoverLocation" Style="{StaticResource Chip}" Content="VPN location" Tag="Location" Click="Hover_Click"/>
                                        <ToggleButton x:Name="HoverIp" Style="{StaticResource Chip}" Content="IP address" Tag="IP" Click="Hover_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="App" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <CheckBox x:Name="StartupToggle" Style="{StaticResource Switch}" Click="StartupToggle_Click" Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Start with Windows" Style="{StaticResource OptionTitle}"/>
                                        <TextBlock Text="Starts in the tray when you sign in, without an admin prompt."
                                                   Style="{StaticResource OptionNote}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Rule}"/>
                                <CheckBox x:Name="UpdateToggle" Style="{StaticResource Switch}" Click="UpdateToggle_Click" Margin="0,8">
                                    <StackPanel>
                                        <TextBlock Text="Update automatically" Style="{StaticResource OptionTitle}"/>
                                        <TextBlock Text="Checks GitHub every 6 hours. New versions are verified before you're asked to restart."
                                                   Style="{StaticResource OptionNote}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Border Style="{StaticResource Rule}"/>
                                <Grid Margin="0,10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="VersionText" Text="Version" Style="{StaticResource OptionTitle}"/>
                                        <TextBlock x:Name="UpdateStatus" Text="" Style="{StaticResource OptionNote}"/>
                                    </StackPanel>
                                    <Button x:Name="CheckNowButton" Style="{StaticResource IconButton}" Width="NaN" Height="30"
                                            HorizontalAlignment="Right" Click="CheckNow_Click">
                                        <TextBlock Text="Check now" FontFamily="{StaticResource Text}" FontSize="12" Margin="12,0"/>
                                    </Button>
                                </Grid>
                                <Border Style="{StaticResource Rule}"/>
                                <Grid Margin="0,10">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,150,0">
                                        <TextBlock Text="Text smoothing" Style="{StaticResource OptionTitle}"/>
                                        <TextBlock Text="Sharp uses ClearType; Smooth uses greyscale anti-aliasing."
                                                   Style="{StaticResource OptionNote}"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="9"
                                            Background="#0DFFFFFF" BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="SmoothClear" Style="{StaticResource Segment}" Content="Sharp"
                                                         GroupName="smooth" Click="Smoothing_Click"/>
                                            <RadioButton x:Name="SmoothGray" Style="{StaticResource Segment}" Content="Smooth"
                                                         GroupName="smooth" Click="Smoothing_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- activity log -->
                <ScrollViewer x:Name="LogPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <TextBlock x:Name="LogEmpty" Text="Nothing yet. Connect or disconnect your VPN to see events here."
                                   FontSize="12" Foreground="{StaticResource Faint}" TextWrapping="Wrap"/>
                        <ItemsControl x:Name="LogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <!-- one check in detail: summary, result rows, what it means -->
                <ScrollViewer x:Name="DetailPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="0,0,4,0">
                        <TextBox x:Name="DetailText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent"
                                 BorderThickness="0" Padding="0" Foreground="{StaticResource Ink}" FontSize="13.5"
                                 FontFamily="{StaticResource Text}" SelectionBrush="#8EE6B8" CaretBrush="Transparent"/>

                        <StackPanel x:Name="FactsHost" Margin="0,14,0,0">
                            <TextBlock Text="Results" FontSize="11" Foreground="{StaticResource Muted}" Margin="2,0,0,6"/>
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Hairline}"
                                    BorderThickness="1" CornerRadius="12" Padding="12,4">
                                <ItemsControl x:Name="FactList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid x:Name="row" Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="118"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="dot" Width="6" Height="6" Margin="0,5,0,0"
                                                         VerticalAlignment="Top" HorizontalAlignment="Left" Fill="Transparent"/>
                                                <TextBlock x:Name="label" Grid.Column="1" Text="{Binding Label}" FontSize="11.5"
                                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                <DockPanel Grid.Column="2">
                                                    <Image DockPanel.Dock="Left" Style="{StaticResource FlagImage}" Margin="0,2,7,0"
                                                           VerticalAlignment="Top"
                                                           Source="{Binding CountryCode, Converter={StaticResource Flag}}"/>
                                                    <TextBlock x:Name="value" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Ok">
                                                    <Setter TargetName="dot" Property="Fill" Value="#8EE6B8"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                    <Setter TargetName="dot" Property="Fill" Value="#FFD58A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Bad">
                                                    <Setter TargetName="dot" Property="Fill" Value="#FF9C9C"/>
                                                    <Setter TargetName="value" Property="Foreground" Value="#FFC2C2"/>
                                                </DataTrigger>
                                                <!-- group heading spans the row -->
                                                <DataTrigger Binding="{Binding Header}" Value="True">
                                                    <Setter TargetName="label" Property="Grid.Column" Value="0"/>
                                                    <Setter TargetName="label" Property="Grid.ColumnSpan" Value="3"/>
                                                    <Setter TargetName="label" Property="FontWeight" Value="SemiBold"/>
                                                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource Ink}"/>
                                                    <Setter TargetName="row" Property="Margin" Value="0,9,0,2"/>
                                                    <Setter TargetName="value" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <Border x:Name="MeaningHost" Margin="0,12,0,4" Background="#0E8EE6B8" BorderBrush="#1F8EE6B8"
                                BorderThickness="1" CornerRadius="12" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="13" Margin="0,1,0,0"
                                           Foreground="{StaticResource Muted}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="What this means" FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MeaningText" FontSize="12" Foreground="#C9CEDA" TextWrapping="Wrap"
                                               Margin="0,4,0,0" LineHeight="17" LineStackingStrategy="BlockLineHeight"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
