<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BorderControl</AssemblyName>
    <Product>Border Control</Product>
    <AssemblyTitle>Border Control</AssemblyTitle>
    <Version>2.0.0</Version>
    <ApplicationIcon>Assets\BorderControl.ico</ApplicationIcon>
    <RootNamespace>VpnGuard</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\BorderControl.ico" />
  </ItemGroup>

</Project>
